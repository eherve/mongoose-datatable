{
  "name": "mongoose-datatable",
  "description": "Server side dataTable request support for mongoose",
  "version": "6.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eherve/mongoose-datatable.git"
  },
  "author": "Eric Herve <eric.herve.95@gmail.com>",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/public-api.js",
  "types": "dist/public-api.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "rm dist/* ; tsc -d",
    "test": "./scripts/test.sh",
    "docker": "docker run -p 27017:27017 --name datatable --rm -d mongo:8.0 && tsc -p ./tsconfig.test.json && c8 mocha -R spec dist/**.spec.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mongoose",
    "dataTable"
  ],
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/chai": "^4.3.5",
    "@types/chai-as-promised": "^7.1.5",
    "@types/lodash": "^4.17.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.10",
    "c8": "^10.1.3",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "mocha": "^11.1.0",
    "mongoose": "^8.9.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "mongoose": "^8.9.5"
  }
}
